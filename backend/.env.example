# GlobeTrotter Backend Environment Variables Example

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globetrotter_db
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: Direct JDBC URL (overrides DB_HOST/DB_NAME if provided)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/globetrotter_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JPA / Hibernate & Flyway Settings
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_FLYWAY_ENABLED=false

# JWT Secret Key (HMAC SHA-256 Base64/Hex Key) & Expiration (in ms, 86400000 = 24h)
JWT_SECRET=your_secure_random_256_bit_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
